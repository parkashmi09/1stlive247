# Copy to .env (never commit .env)
NODE_ENV=development
PORT=4247
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/score247
# Comma-separated origins allowed for REST + Socket.IO (the Next.js app)
CORS_ORIGINS=http://localhost:3247
LOG_LEVEL=info

# Live data source: "mock" simulates matches. Set to a real provider once keys are shared.
LIVE_PROVIDER=sportsapi
# Mock ball interval in ms
MOCK_TICK_MS=4000

# Real sports data provider (fill when available)
PROVIDER_API_KEY=
PROVIDER_BASE_URL=http://187.53.141.8:9232
CRICBUZZ_BASE_URL=http://187.53.141.8:9228
CRICBUZZ_API_KEY=
