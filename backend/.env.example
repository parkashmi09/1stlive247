# Copy to .env (never commit .env)
NODE_ENV=development
PORT=4247
DATABASE_URL=postgres://apple@localhost:5432/score247
# Comma-separated origins allowed for REST + Socket.IO (the Next.js app)
CORS_ORIGINS=http://localhost:3247
LOG_LEVEL=info

# Live data source: "sportsapi" = in-house Sports API (needs key + allowed IP), "mock" = simulated demo, "none"
LIVE_PROVIDER=mock
# Mock ball interval in ms
MOCK_TICK_MS=4000

# Real sports data provider (fill when available)
PROVIDER_API_KEY=
PROVIDER_BASE_URL=http://187.53.141.8:9232
